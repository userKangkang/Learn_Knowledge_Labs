DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_SEARCH_MODEL=deepseek-v4-flash

MOONSHOT_API_KEY=
# 也可用 KIMI_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k3

CHATGPT_API_KEY=
CHATGPT_BASE_URL=https://zctotoken.com/v1
CHATGPT_MODEL=gpt-5.6-terra

LLM_TEMPERATURE=0.2
LLM_THINKING_ENABLED=true
LLM_REASONING_EFFORT=high
DEFAULT_TEXT_PROVIDER=deepseek

# PDF attachments are rendered as Kimi visual inputs in node conversations.
PDF_VISUAL_MAX_PAGES=24
PDF_VISUAL_MAX_EDGE=1600
PDF_VISUAL_JPEG_QUALITY=72
